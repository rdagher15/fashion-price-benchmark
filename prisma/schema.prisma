// HarvestLink — Farmer-Retailer fresh produce marketplace
// SQLite for MVP simplicity (zero external infra). Swap DATABASE_URL/provider
// to postgresql for production; schema is written to be portable (no native
// enums or arrays, since SQLite supports neither in Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Users & Auth ----------

model User {
  id           String   @id @default(cuid())
  role         String // FARMER | BUYER | ADMIN
  status       String   @default("ACTIVE") // ACTIVE | PENDING | SUSPENDED
  firstName    String
  lastName     String
  email        String   @unique
  phone        String
  passwordHash String
  nationality  String?
  idInfo       String?
  preferredLanguage String @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farmerProfile FarmerProfile?
  buyerProfile  BuyerProfile?
  notifications Notification[]
  reviewsGiven  Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

// ---------- Farmer side ----------

model FarmerProfile {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])

  farmName        String
  region          String
  city            String
  latitude        Float?
  longitude       Float?
  farmSizeValue   Float?
  farmSizeUnit    String? // hectares, acres, dunums
  farmType        String? // family/commercial/cooperative etc
  yearsOperating  Int?
  numWorkers      Int?

  hasOwnVehicle   Boolean @default(false)
  vehicleType     String?
  vehicleCapacity String?
  refrigerated    Boolean @default(false)
  deliveryRadiusKm Float?
  canDeliver      Boolean @default(false)
  allowPickup     Boolean @default(true)
  sharedDelivery  Boolean @default(false)
  altDeliveryNote String?

  supportTypesJson String @default("[]") // JSON array: government/ngo/cooperative/private/other
  supportDescription String?

  usesPesticides  Boolean?
  usesFertilizers Boolean?
  organic         Boolean @default(false)
  conventional    Boolean @default(true)
  farmingNotes    String?
  certificationsJson String @default("[]") // JSON array of {name, docUrl}

  verificationStatus String @default("PENDING") // PENDING | VERIFIED | REJECTED
  profileCompletionPct Int @default(20)

  ratingAvg       Float @default(0)
  ratingCount     Int   @default(0)
  completedOrders Int   @default(0)
  onTimeDeliveryRate Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       FarmPhoto[]
  produceItems FarmerProduce[]
  listings     Listing[]
  offers       Offer[]
  orders       Order[]
}

model FarmPhoto {
  id              String @id @default(cuid())
  farmerProfileId String
  farmerProfile   FarmerProfile @relation(fields: [farmerProfileId], references: [id])
  url             String
  category        String // overview | fields | storage | equipment | other
  caption         String?
  createdAt       DateTime @default(now())
}

// What a farmer typically produces (capability, distinct from a specific listing)
model FarmerProduce {
  id                String @id @default(cuid())
  farmerProfileId   String
  farmerProfile     FarmerProfile @relation(fields: [farmerProfileId], references: [id])
  produceCategoryId String
  produceCategory   ProduceCategory @relation(fields: [produceCategoryId], references: [id])

  typicalQuantity   Float?
  unit              String?
  productionFrequency String? // daily/weekly/seasonal/one-off
  productionSeason   String?
  availabilityStart DateTime?
  availabilityEnd   DateTime?
  nextAvailability  DateTime?

  createdAt DateTime @default(now())
}

// ---------- Buyer side ----------

model BuyerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  businessName       String
  buyerType          String // supermarket|grocery|restaurant|hotel|hospital|school|catering|other
  contactPerson      String?
  businessRegistrationInfo String?
  region             String
  city               String
  latitude           Float?
  longitude          Float?

  verificationStatus String @default("PENDING")
  profileCompletionPct Int @default(30)

  ratingAvg       Float @default(0)
  ratingCount     Int   @default(0)
  completedOrders Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryLocations BuyerDeliveryLocation[]
  requirements      Requirement[]
  offers            Offer[]
  orders            Order[]
}

model BuyerDeliveryLocation {
  id             String @id @default(cuid())
  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id])
  label          String
  address        String
  latitude       Float?
  longitude      Float?
  isPrimary      Boolean @default(false)
}

// ---------- Produce taxonomy (admin-managed, extensible) ----------

model ProduceCategory {
  id           String @id @default(cuid())
  family       String // Vegetables | Fruits | Herbs | Leafy Greens | Root Vegetables | Other
  name         String // Tomatoes, Cucumbers, ...
  variety      String?
  defaultUnit  String @default("kg")
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  farmerProduce FarmerProduce[]
  listings      Listing[]
  requirements  Requirement[]

  @@unique([family, name, variety])
}

// ---------- Listings (supply) ----------

model Listing {
  id                String @id @default(cuid())
  farmerProfileId   String
  farmerProfile     FarmerProfile @relation(fields: [farmerProfileId], references: [id])
  produceCategoryId String
  produceCategory   ProduceCategory @relation(fields: [produceCategoryId], references: [id])

  variety   String?
  photoUrl  String?

  quantity          Float
  unit              String
  minOrderQuantity  Float?

  availableFrom DateTime
  availableUntil DateTime
  readyDate     DateTime?

  grade             String?
  sizeSpec          String?
  qualityLevel      String?
  productionMethod  String @default("conventional") // organic | conventional
  certificationNote String?

  packagingType   String? // loose|box|crate|bag|carton|other
  unitsPerPackage Float?
  packageWeight   Float?

  deliveryMethodsJson String @default("[\"buyer_pickup\"]") // farmer_delivery|buyer_pickup|third_party|other
  deliveryRadiusKm Float?
  deliveryCost     Float?

  minPrice       Float
  preferredPrice Float?
  maxPrice       Float?
  priceUnit      String @default("kg")

  status String @default("PUBLISHED")
  // Draft|Published|Offers Received|Offer Accepted|Order Preparation|
  // Ready for Delivery|Out for Delivery|Delivered|Completed|Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches  Match[]
  offers   Offer[]
  orders   Order[]
}

// ---------- Requirements (demand) ----------

model Requirement {
  id                String @id @default(cuid())
  buyerProfileId    String
  buyerProfile      BuyerProfile @relation(fields: [buyerProfileId], references: [id])
  produceCategoryId String
  produceCategory   ProduceCategory @relation(fields: [produceCategoryId], references: [id])

  quantity    Float
  minQuantity Float?
  maxQuantity Float?
  unit        String @default("kg")

  requiredDate       DateTime
  recurring          Boolean @default(false)
  recurringFrequency String?

  deliveryLocationLabel String
  deliveryAddress       String?
  deliveryLatitude      Float?
  deliveryLongitude     Float?

  packagingRequirement  String?
  qualityRequirement    String?
  productionRequirement String? // organic | conventional | no_preference

  minPrice  Float?
  maxPrice  Float?
  priceUnit String @default("kg")

  status String @default("ACTIVE") // Active|Matched|Offer Sent|Fulfilled|Cancelled|Expired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]
  offers  Offer[]
  orders  Order[]
}

// ---------- Matching engine output ----------

model MatchingConfig {
  id               String @id @default("singleton")
  weightProduce    Float @default(30)
  weightQuantity   Float @default(20)
  weightDate       Float @default(20)
  weightGeo        Float @default(15)
  weightDelivery   Float @default(10)
  weightPrice      Float @default(5)
  maxDistanceKm    Float @default(300)
  updatedAt        DateTime @updatedAt
}

model Match {
  id            String @id @default(cuid())
  listingId     String
  listing       Listing @relation(fields: [listingId], references: [id])
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  score          Float
  produceScore   Float
  quantityScore  Float
  dateScore      Float
  geoScore       Float
  deliveryScore  Float
  priceScore     Float
  distanceKm     Float?

  status String @default("SUGGESTED") // SUGGESTED|VIEWED|OFFERED|DISMISSED

  createdAt DateTime @default(now())

  @@unique([listingId, requirementId])
}

// ---------- Offers & Negotiation ----------

model Offer {
  id            String @id @default(cuid())
  listingId     String
  listing       Listing @relation(fields: [listingId], references: [id])
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])

  buyerProfileId  String
  buyerProfile    BuyerProfile @relation(fields: [buyerProfileId], references: [id])
  farmerProfileId String
  farmerProfile   FarmerProfile @relation(fields: [farmerProfileId], references: [id])

  quantity  Float
  price     Float
  priceUnit String @default("kg")

  deliveryDate          DateTime
  deliveryMethod         String // farmer_delivery|buyer_pickup|third_party|other
  deliveryLocationLabel  String?
  deliveryLatitude       Float?
  deliveryLongitude      Float?
  packagingNote          String?
  message                String?

  initiatedBy String @default("BUYER") // BUYER | FARMER
  status      String @default("PENDING") // PENDING|COUNTERED|ACCEPTED|REJECTED|CANCELLED|EXPIRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  negotiations Negotiation[]
  order        Order?
}

model Negotiation {
  id        String @id @default(cuid())
  offerId   String
  offer     Offer  @relation(fields: [offerId], references: [id])
  sender    String // BUYER | FARMER
  price     Float
  quantity  Float
  rationale String?
  createdAt DateTime @default(now())
}

// ---------- Orders & fulfillment ----------

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique
  offerId     String @unique
  offer       Offer  @relation(fields: [offerId], references: [id])

  listingId     String
  listing       Listing @relation(fields: [listingId], references: [id])
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])

  buyerProfileId  String
  buyerProfile    BuyerProfile @relation(fields: [buyerProfileId], references: [id])
  farmerProfileId String
  farmerProfile   FarmerProfile @relation(fields: [farmerProfileId], references: [id])

  produceLabel String // denormalized for quick display

  quantity     Float
  unit         String
  agreedPrice  Float
  priceUnit    String
  totalValue   Float

  deliveryDate          DateTime
  deliveryMethod         String
  deliveryLocationLabel  String?
  deliveryAddress        String?
  deliveryLatitude       Float?
  deliveryLongitude      Float?

  deliveryPersonType String? // farmer | other_farmer | driver | third_party | buyer_pickup
  deliveryPersonName String?
  deliveryContact    String?

  status String @default("ACCEPTED")
  // Accepted|Preparing|Ready|Out for Delivery|Delivered|Confirmed|Completed|Cancelled

  dispatchedAt DateTime?
  deliveredAt  DateTime?

  receivedQuantity  Float?
  receivedCondition String? // good|damaged|partial
  receivedNote      String?
  confirmedAt       DateTime?

  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist OrderChecklistItem[]
  reviews   Review[]
}

model OrderChecklistItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id])
  task        String
  completed   Boolean @default(false)
  completedAt DateTime?
  sortOrder   Int @default(0)
}

// ---------- Trust & Notifications ----------

model Review {
  id              String @id @default(cuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id])
  reviewerId      String
  reviewer        User   @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewedPartyId String
  reviewedParty   User   @relation("ReviewsReceived", fields: [reviewedPartyId], references: [id])
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  link      String?
  read      Boolean @default(false)
  createdAt DateTime @default(now())
}
